{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:rules": "jest --config jest.rules.config.js",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start",
    "emulators:seed": "firebase emulators:exec --only firestore \"node scripts/seed.mjs\"",
    "rules:test": "firebase emulators:exec --only firestore,storage \"npm run test:rules\"",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy": "firebase deploy --only firestore,storage"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@repo/shared": "workspace:*",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.102.8",
    "cloudinary": "^2.11.0",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "^57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "^57.0.16",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "^57.0.17",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "^57.0.18",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "^57.0.21",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.17.0",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.1.0",
