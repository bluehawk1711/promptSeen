rules_version = '2';

// Firestore security rules for PromptSeen.
//
// Collections:
//   prompts, categories  — public read, admin write
//   users               — user read/write own, admin read/write all
//   collections         — user read/write own, public read public ones
//   submissions         — user create + read own, admin read/write all
//   analytics_events    — app write (client-side), admin read
//   daily_stats         — app write (client-side), admin read

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Prompts ──────────────────────────────────────────────────────
    match /prompts/{promptId} {
      allow read: if true;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Categories ───────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Users ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Collections (user-created prompt boards) ─────────────────────
    match /collections/{collectionId} {
      // Anyone can read public collections; owners can read their own.
      allow read: if isOwner(resource.data.ownerId)
        || resource.data.isPublic == true
        || isAdmin();

      // Authenticated users can create collections.
      allow create: if isAuthenticated();

      // Only the owner can update/delete their collection.
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ─── Submissions (user-submitted prompts) ─────────────────────────
    match /submissions/{submissionId} {
      // Users can read their own submissions; admins can read all.
      allow read: if isOwner(resource.data.submitterUid) || isAdmin();

      // Authenticated users can submit prompts.
      allow create: if isAuthenticated()
        && request.resource.data.submitterUid == request.auth.uid;

      // Only admins can update (approve/reject) submissions.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Analytics Events ─────────────────────────────────────────────
    match /analytics_events/{eventId} {
      // Only admins can read analytics.
      allow read: if isAdmin();

      // Anyone can write events (fire-and-forget from client).
      allow create: if true;
      allow update, delete: if false;
    }

    // ─── Daily Stats ──────────────────────────────────────────────────
    match /daily_stats/{date} {
      // Only admins can read stats.
      allow read: if isAdmin();

      // App can write/update daily stats (merge writes).
      allow create, update: if true;
      allow delete: if false;

      // Active users subcollection for deduplication
      match /active_users/{userId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // ─── FCM Tokens ──────────────────────────────────────────────────
    match /fcm_tokens/{tokenId} {
      // Tokens are readable by admins; the app writes its own token.
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ─── Push Notifications ───────────────────────────────────────────
    match /push_notifications/{notifId} {
      // Only admins can read notification history.
      allow read: if isAdmin();

      // Notifications are sent via server — no direct client writes.
      allow create, update, delete: if false;
    }

    // ─── Settings (admin-only app config) ─────────────────────────────
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Helper functions ─────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAuthenticated() {
      return request.auth != null;
    }
  }
}
